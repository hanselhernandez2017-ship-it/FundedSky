# Required
DATABASE_URL=postgres://user:pass@host:5432/db
PUBLIC_URL=https://your-domain.com
# Emails that become admins when they sign up (comma separated)
ADMIN_EMAILS=you@example.com
# Optional: Stripe (test or live). Without it, checkout runs in built-in test mode (card 4242 4242 4242 4242).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: send real email through Resend. Without it, emails are only logged to the back office outbox.
RESEND_API_KEY=
MAIL_FROM=Funded Sky <no-reply@your-domain.com>
# Optional: SEED_DEMO=1 adds labelled demo traders on first boot. SIM_FEED=off stops the simulated trade feed.
SEED_DEMO=
SIM_FEED=
